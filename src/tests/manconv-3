#! /bin/sh

# Test manconv's handling of incomplete characters at end of file.

: ${srcdir=.}
. "$srcdir/testlib.sh"

: ${MANCONV=manconv}

init

# LIBCn iconv cannot open the EUC-JP converter used here and does not
# support GNU //IGNORE, so this cannot test incomplete-input handling.
case $(uname -s) in
	OS/2*) skip 'LIBCn iconv lacks required EUC-JP/IGNORE support' ;;
esac

printf '\314' >"$tmpdir/1.inp"  # 0xCC
expect_pass 'incomplete character at EOF' '! run $MANCONV -f EUC-JP -t UTF-8//IGNORE <"$tmpdir/1.inp" >/dev/null'

finish
